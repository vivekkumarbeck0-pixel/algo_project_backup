# Copy this file to .env and replace every placeholder with your Angel One values.
# Never commit .env or share these credentials.
ANGEL_ONE_API_KEY=your_api_key
ANGEL_ONE_CLIENT_ID=your_client_id
ANGEL_ONE_PASSWORD=your_password
ANGEL_ONE_TOTP=your_totp_code_or_totp_secret
ANGEL_ONE_JWT_TOKEN=your_jwt_access_token

# Required by trading_crude.py for the SmartWebSocketV2 market feed.
ANGEL_ONE_FEED_TOKEN=your_feed_token

# Exact MCX Crude futures token from Angel One's instrument list.
MCX_CRUDE_FUTURE_TOKEN=your_mcx_crude_future_token
